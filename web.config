<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <modules>
            <remove name="WebDAVModule" />
        </modules>
        
        <handlers>
            <remove name="WebDAV" />
            <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
        </handlers>
        
        <httpPlatform processPath="C:\inetpub\wwwroot\backurban\venv\Scripts\python.exe"
                      arguments="C:\inetpub\wwwroot\backurban\run_server.py"
                      stdoutLogEnabled="true"
                      stdoutLogFile=".\logs\python.log"
                      startupTimeLimit="60">
            <environmentVariables>
                <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
                <environmentVariable name="DJANGO_SETTINGS_MODULE" value="urban_gis.settings" />
            </environmentVariables>
        </httpPlatform>
    </system.webServer>
</configuration>